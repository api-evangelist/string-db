                  "value": "<integer>",
                  "description": "NCBI taxon ID to restrict results to a specific organism. Common values: 9606 (human), 10090 (mouse), 10116 (rat), 7227 (D. melanogaster), 6239 (C. elegans), 4932 (S. cerevisiae), 3702 (A. thaliana), 7955 (zebrafish).\n"
                },
                {
                  "disabled": false,
                  "key": "required_score",
                  "value": "400",
                  "description": "Minimum combined interaction score threshold (0-1000). Higher values return only higher-confidence interactions. Common thresholds: 150 (low), 400 (medium), 700 (high), 900 (highest).\n"
                },
                {
                  "disabled": false,
                  "key": "network_type",
                  "value": "functional",
                  "description": "Type of STRING network to use"
