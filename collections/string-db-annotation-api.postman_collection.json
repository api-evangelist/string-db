        {
          "id": "1fd34f70-5a33-4150-8894-f4cee21da810",
          "name": "Functional Annotation",
          "request": {
            "name": "Functional Annotation",
            "description": {
              "content": "Retrieve all functional annotations associated with input proteins. Includes GO terms, KEGG pathways, Pfam/InterPro/SMART domains, tissue expression (COMPARTMENTS), and disease associations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":format",
                "functional_annotation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "identifiers",
                  "value": "<string>",
                  "description": "(Required) Protein identifiers, newline-separated (%0d in URL)"
                },
                {
                  "disabled": false,
                  "key": "species",
                  "value": "<integer>",
                  "description": "NCBI taxon ID to restrict results to a specific organism. Common values: 9606 (human), 10090 (mouse), 10116 (rat), 7227 (D. melanogaster), 6239 (C. elegans), 4932 (S. cerevisiae), 3702 (A. thaliana), 7955 (zebrafish).\n"
                },
                {
                  "disabled": false,
                  "key": "allow_pubmed",
                  "value": "0",
                  "description": "Include PubMed text mining annotations (1=include)"
                },
                {
                  "disabled": false,
                  "key": "caller_identity",
                  "value": "<string>",
                  "description": "A string identifying your application or organization. Strongly recommended; helps STRING admins contact you if there are issues.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "format",
                  "description": "(Required) Output format"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
