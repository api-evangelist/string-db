          "name": "Get STRING IDs",
          "request": {
            "name": "Get STRING IDs",
            "description": {
              "content": "Map gene names, protein synonyms, or UniProt IDs to STRING identifiers. Use the returned STRING IDs in subsequent API calls for best performance.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":format",
                "get_string_ids"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "identifiers",
                  "value": "<string>",
                  "description": "(Required) Protein identifiers to map (names, synonyms, UniProt IDs). Separate multiple identifiers with URL-encoded newline (%0d) for GET requests, or actual newline/carriage-return for POST requests.\n"
                },
                {
                  "disabled": false,
                  "key": "species",
                  "value": "<integer>",
                  "description": "NCBI taxon ID to restrict results to a specific organism. Common values: 9606 (human), 10090 (mouse), 10116 (rat), 7227 (D. melanogaster), 6239 (C. elegans), 4932 (S. cerevisiae), 3702 (A. thaliana), 7955 (zebrafish).\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1",
                  "description": "Maximum number of matches to return per input identifier"
                },
                {
                  "disabled": false,
                  "key": "echo_query",
                  "value": "0",
                  "description": "If 1, include the original query identifier in the output"
                },
                {
                  "disabled": false,
                  "key": "caller_identity",
                  "value": "<string>",
                  "description": "A string identifying your application or organization. Strongly recommended; helps STRING admins contact you if there are issues.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
