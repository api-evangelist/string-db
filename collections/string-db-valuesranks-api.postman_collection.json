        {
          "id": "cd384ab6-de0e-45b9-8328-b68f974100b1",
          "name": "Submit Values/Ranks Enrichment Job",
          "request": {
            "name": "Submit Values/Ranks Enrichment Job",
            "description": {
              "content": "Submit a GSEA-like enrichment analysis on a ranked list of proteins with associated numeric values (e.g. fold-change, log p-value). Accepts up to 1000 concurrent jobs per API key. Returns a job_id to poll with the status endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "json",
                "valuesranks_enrichment_submit"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) API key obtained via the get_api_key endpoint"
                },
                {
                  "disabled": false,
                  "key": "identifiers",
                  "value": "<string>",
                  "description": "(Required) Tab-separated protein-value pairs, one per line. Each line: STRING_ID<TAB>numeric_value\n"
                },
                {
                  "disabled": false,
                  "key": "species",
                  "value": "<integer>",
                  "description": "(Required) NCBI taxon ID"
                },
                {
                  "disabled": false,
                  "key": "ge_fdr",
                  "value": "0.01",
                  "description": "False discovery rate threshold for significance (default 0.01)"
                },
                {
                  "disabled": false,
                  "key": "caller_identity",
                  "value": "<string>",
                  "description": "Identifier for your application"
                }
              ]
            }
