      },
      "item": [
        {
          "id": "c542525f-b493-473e-8f8b-21120da082d9",
          "name": "Network Image or Interactions",
          "request": {
            "name": "Network Image or Interactions",
            "description": {
              "content": "Retrieve a protein interaction network as an image or interaction data. Supports image formats (image, highres_image, svg) and data formats (tsv, json, xml, psi-mi, psi-mi-tab).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":format",
                "network"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "identifiers",
                  "value": "<string>",
                  "description": "(Required) Protein identifiers (STRING IDs or gene names), newline-separated (%0d in URL)"
                },
                {
                  "disabled": false,
                  "key": "species",
                  "value": "<integer>",
                  "description": "NCBI taxon ID to restrict results to a specific organism. Common values: 9606 (human), 10090 (mouse), 10116 (rat), 7227 (D. melanogaster), 6239 (C. elegans), 4932 (S. cerevisiae), 3702 (A. thaliana), 7955 (zebrafish).\n"
                },
                {
                  "disabled": false,
                  "key": "required_score",
                  "value": "400",
                  "description": "Minimum combined interaction score threshold (0-1000). Higher values return only higher-confidence interactions. Common thresholds: 150 (low), 400 (medium), 700 (high), 900 (highest).\n"
                },
                {
                  "disabled": false,
                  "key": "network_type",
                  "value": "functional",
                  "description": "Type of STRING network to use"
                },
                {
                  "disabled": false,
                  "key": "network_flavor",
                  "value": "evidence",
                  "description": "Visual style for network edges"
                },
                {
                  "disabled": false,
                  "key": "add_color_nodes",
                  "value": "0",
                  "description": "Number of additional neighborhood proteins to add (shown in color)"
                },
                {
                  "disabled": false,
                  "key": "add_white_nodes",
                  "value": "0",
                  "description": "Number of additional neighborhood proteins to add (shown in white)"
                },
                {
                  "disabled": false,
                  "key": "hide_node_labels",
                  "value": "0",
                  "description": "Hide protein name labels on network nodes (1=hide, 0=show)"
                },
                {
                  "disabled": false,
                  "key": "hide_disconnected_nodes",
                  "value": "0",
                  "description": "Hide proteins with no interactions in the result set (1=hide)"
                },
                {
                  "disabled": false,
                  "key": "caller_identity",
                  "value": "<string>",
                  "description": "A string identifying your application or organization. Strongly recommended; helps STRING admins contact you if there are issues.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "format",
                  "description": "(Required) Output format (data or image)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
